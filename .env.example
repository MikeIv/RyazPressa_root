# Публичные переменные (префикс NUXT_PUBLIC_ попадает на клиент).
# Без завершающего слэша.

# Контент API: новости, округа, проекты, документы, контакты, подписка.
NUXT_PUBLIC_API_BASE=https://api.ryazpressa.ru

# Хост GET /api/_site. Совпадает с API.
NUXT_PUBLIC_SITE_CONFIG_API_BASE=https://api.ryazpressa.ru

# Mock не используется. true — только если локальные фикстуры появятся отдельно.
NUXT_USE_MOCK_API=false
